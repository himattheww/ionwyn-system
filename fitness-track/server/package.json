{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --env-file-if-exists=../../.env --watch src/index.ts",
    "start": "node --env-file-if-exists=../.env --env-file-if-exists=../../.env src/index.ts",
    "garmin:login": "node --env-file-if-exists=../.env --env-file-if-exists=../../.env src/garmin/login.ts",
    "garmin:reparse": "node --env-file-if-exists=../.env --env-file-if-exists=../../.env src/garmin/reparse.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "garmin:sync": "node --env-file-if-exists=../.env --env-file-if-exists=../../.env src/garmin/sync-now.ts",
    "garmin:backfill": "node --env-file-if-exists=../.env --env-file-if-exists=../../.env src/garmin/backfill.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "playwright": "^1.64.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
