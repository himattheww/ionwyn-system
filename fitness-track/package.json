{
  "name": "fitness-track",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "npm start -w server",
    "test": "npm test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "garmin:login": "npm run garmin:login -w server",
    "garmin:reparse": "npm run garmin:reparse -w server",
    "garmin:sync": "npm run garmin:sync -w server"
  }
}
