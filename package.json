{
  "name": "ionwyn-system",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "build": "node --env-file-if-exists=.env scripts/build.mjs",
    "start": "node --env-file-if-exists=.env scripts/run.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "test": "node scripts/test.mjs",
    "garmin:login": "cd backend/fitness && node --env-file-if-exists=.env --env-file-if-exists=../../.env src/garmin/login.ts",
    "garmin:sync": "cd backend/fitness && node --env-file-if-exists=.env --env-file-if-exists=../../.env src/garmin/sync-now.ts",
    "garmin:reparse": "cd backend/fitness && node --env-file-if-exists=.env --env-file-if-exists=../../.env src/garmin/reparse.ts",
    "garmin:backfill": "cd backend/fitness && node --env-file-if-exists=.env --env-file-if-exists=../../.env src/garmin/backfill.ts",
    "jadwal:seed": "cd backend/jadwal && tsx scripts/seed.ts",
    "jadwal:seed:clear": "cd backend/jadwal && tsx scripts/seed.ts clear",
    "screenshots": "node scripts/screenshots.mjs",
    "compare": "node scripts/compare-screenshots.mjs"
  },
  "dependencies": {
    "@iconify/vue": "^4.1.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@phosphor-icons/web": "^2.1.2",
    "@supabase/supabase-js": "^2.105.0",
    "apexcharts": "^5.10.0",
    "dayjs": "^1.11.13",
    "express": "^5.3.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "node-notifier": "^11.0.0",
    "pinia": "^3.0.4",
    "playwright": "^1.64.1",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sweetalert2": "^11.26.25",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue3-apexcharts": "^1.11.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/node-notifier": "^8.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
